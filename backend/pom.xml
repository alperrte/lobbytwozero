<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ltz</groupId>
    <artifactId>ltz-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>LobbyTwoZero Backend</name>
    <description>LTZ Microservices Parent Project</description>

    <properties>
        <java.version>25</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <dotenv.version>3.2.0</dotenv.version>
        <springdoc.version>3.1.1</springdoc.version>
        <jacoco.version>0.8.15</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <pmd.version>7.28.0</pmd.version>
        <ltz.configDirectory>${maven.multiModuleProjectDirectory}/config</ltz.configDirectory>
        <ltz.test.postgres.port>65432</ltz.test.postgres.port>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ssXXX</maven.build.timestamp.format>
        <!-- verify rejects explicit skip flags; package may still skip tests. -->
        <skipTests>false</skipTests>
        <maven.test.skip>false</maven.test.skip>
        <maven.test.skip.exec>false</maven.test.skip.exec>
        <jacoco.skip>false</jacoco.skip>

        <sonar.projectKey>ltz-backend</sonar.projectKey>
        <sonar.projectName>LobbyTwoZero Backend</sonar.projectName>
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
        <sonar.java.jdkHome>${java.home}</sonar.java.jdkHome>
    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

                    <dependency>
                <groupId>io.github.cdimascio</groupId>
                <artifactId>dotenv-java</artifactId>
                <version>${dotenv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <configuration><title>${project.artifactId}</title></configuration>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><failIfNoTests>true</failIfNoTests></configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${ltz.configDirectory}/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>java-structure</id><phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId><artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId><artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetJdk>25</targetJdk>
                    <!-- Skip only empty HTML; PMD XML analysis and the check goal remain mandatory. -->
                    <skipEmptyReport>true</skipEmptyReport>
                    <includeTests>true</includeTests>
                    <rulesets><ruleset>${ltz.configDirectory}/pmd.xml</ruleset></rulesets>
                    <linkXRef>false</linkXRef>
                    <failOnViolation>true</failOnViolation>
                    <skipPmdError>false</skipPmdError>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>java-behavior</id><phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo still instruments/reports every production class. A single
                 reviewed policy owns strict, bootstrap and changed-line gates. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>coverage-policy</id><phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>node</executable>
                            <arguments>
                                <argument>${ltz.configDirectory}/../../pre-push/ci/coverage.mjs</argument>
                                <argument>maven-module</argument>
                                <argument>${project.basedir}</argument>
                                <argument>${maven.build.timestamp}</argument>
                                <argument>${skipTests}</argument>
                                <argument>${maven.test.skip}</argument>
                                <argument>${maven.test.skip.exec}</argument>
                                <argument>${jacoco.skip}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <ltz.test.external-postgres>true</ltz.test.external-postgres>
                                <spring.datasource.url>jdbc:postgresql://127.0.0.1:${ltz.test.postgres.port}/${project.artifactId}</spring.datasource.url>
                                <spring.datasource.username>ltz_test</spring.datasource.username>
                                <spring.datasource.password>ltz_test_only</spring.datasource.password>
                                <spring.security.user.password>ltz_test_only</spring.security.user.password>
                                <spring.mail.host>127.0.0.1</spring.mail.host>
                                <spring.mail.port>1</spring.mail.port>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <modules>
        <module>services/auth-service</module>
        <module>services/user-service</module>
        <module>services/mail-service</module>
        <module>services/game-service</module>
        <module>services/library-service</module>
        <module>services/review-service</module>
        <module>services/social-service</module>
        <module>services/messaging-service</module>
        <module>services/lfp-service</module>
        <module>services/community-service</module>
        <module>services/content-service</module>
        <module>services/event-service</module>
        <module>services/hardware-service</module>
        <module>services/recommendation-service</module>
        <module>services/performance-service</module>
        <module>services/admin-service</module>
        <module>services/notification-service</module>
        <module>services/api-gateway</module>
    </modules>

</project>
