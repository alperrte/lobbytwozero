<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%level %logger{32} - %msg%n</pattern></encoder></appender>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.hibernate" level="ERROR"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
