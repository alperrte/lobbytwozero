# ==========================================
# LOBBYTWOZERO - ENV TEMPLATE
# ==========================================

# APPLICATION
APP_NAME=ltz
APP_ENV=dev
COMPOSE_PROJECT_NAME=ltz-dev
SPRING_PROFILES_ACTIVE=dev
TZ=UTC
# Yalniz development: Mailpit'i baslatir. .env.prod'a EKLENMEZ.
COMPOSE_PROFILES=dev-mail
# Istege bagli Mailpit host portlari (varsayilanlar 1025 / 8025, yalniz 127.0.0.1)
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025

# ==========================================
# FRONTEND
# ==========================================

FRONTEND_HOST_PORT=5001
FRONTEND_INTERNAL_PORT=3000
FRONTEND_PUBLIC_URL=http://localhost:5001
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
CORS_ALLOWED_ORIGINS=http://localhost:5001

# ==========================================
# API GATEWAY
# ==========================================

API_GATEWAY_HOST_PORT=5080
API_GATEWAY_PUBLIC_URL=http://localhost:5080
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080

# ==========================================
# MICROSERVICE HOST PORTS
# ==========================================

AUTH_SERVICE_HOST_PORT=5081
USER_SERVICE_HOST_PORT=5082
MAIL_SERVICE_HOST_PORT=5083

GAME_SERVICE_HOST_PORT=5084
LIBRARY_SERVICE_HOST_PORT=5085
REVIEW_SERVICE_HOST_PORT=5086

SOCIAL_SERVICE_HOST_PORT=5087
MESSAGING_SERVICE_HOST_PORT=5088
LFP_SERVICE_HOST_PORT=5089

COMMUNITY_SERVICE_HOST_PORT=5090
CONTENT_SERVICE_HOST_PORT=5091
EVENT_SERVICE_HOST_PORT=5092

HARDWARE_SERVICE_HOST_PORT=5093
RECOMMENDATION_SERVICE_HOST_PORT=5094
PERFORMANCE_SERVICE_HOST_PORT=5095

ADMIN_SERVICE_HOST_PORT=5096
NOTIFICATION_SERVICE_HOST_PORT=5097

# COMMON CONTAINER PORT
BACKEND_INTERNAL_PORT=8080

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5542

POSTGRES_USER=ltz_dev
POSTGRES_PASSWORD=CHANGE_ME_FOR_DEV
POSTGRES_DB=postgres

DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1

# ==========================================
# DATABASE NAMES
# ==========================================

DB_AUTH_NAME=auth_db
DB_USER_NAME=user_db
DB_MAIL_NAME=mail_db

DB_GAME_NAME=game_db

# Steam catalogue: enable only after authorized API access is verified.
STEAM_WEB_API_KEY=
STEAM_CATALOG_ENABLED=false
DB_LIBRARY_NAME=library_db
DB_REVIEW_NAME=review_db

DB_SOCIAL_NAME=social_db
DB_MESSAGING_NAME=messaging_db
DB_LFP_NAME=lfp_db

DB_COMMUNITY_NAME=community_db
DB_CONTENT_NAME=content_db
DB_EVENT_NAME=event_db

DB_HARDWARE_NAME=hardware_db
DB_RECOMMENDATION_NAME=recommendation_db
DB_PERFORMANCE_NAME=performance_db

DB_ADMIN_NAME=admin_db
DB_NOTIFICATION_NAME=notification_db

# ==========================================
# MICROSERVICE INTERNAL URLS
# ==========================================

AUTH_SERVICE_URL=http://auth-service:8080
USER_SERVICE_URL=http://user-service:8080
MAIL_SERVICE_URL=http://mail-service:8080

GAME_SERVICE_URL=http://game-service:8080
LIBRARY_SERVICE_URL=http://library-service:8080
REVIEW_SERVICE_URL=http://review-service:8080

SOCIAL_SERVICE_URL=http://social-service:8080
MESSAGING_SERVICE_URL=http://messaging-service:8080
LFP_SERVICE_URL=http://lfp-service:8080

COMMUNITY_SERVICE_URL=http://community-service:8080
CONTENT_SERVICE_URL=http://content-service:8080
EVENT_SERVICE_URL=http://event-service:8080

HARDWARE_SERVICE_URL=http://hardware-service:8080
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8080
PERFORMANCE_SERVICE_URL=http://performance-service:8080

ADMIN_SERVICE_URL=http://admin-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# ==========================================
# SPRING RESTCLIENT
# ==========================================

REST_CLIENT_CONNECT_TIMEOUT_MS=3000
REST_CLIENT_READ_TIMEOUT_MS=5000

# ==========================================
# SECURITY
# ==========================================

JWT_ISSUER=ltz-auth
JWT_ACCESS_TTL_SECONDS=60
JWT_REFRESH_TTL_SECONDS=604800

# Auth Service ayarlari (ISO-8601 sureler; hepsi opsiyonel, gosterilen deger varsayilandir).
# Gecersiz/sinir disi deger servisin baslamasini engeller. Cerez Secure/SameSite/__Host- ayarlari
# guvenlik geregi kodda sabittir (prod'da ENV ile kapatilamaz).
# JWT_AUDIENCE=ltz-api                  # access token aud degeri; tuketici servislerin dogruladigi deger ile ayni olmali
# AUTH_SESSION_ABSOLUTE_TTL=P30D        # oturum mutlak ust siniri (1-90 gun)
# AUTH_OTP_TTL=PT10M                    # e-posta dogrulama kodu omru (1-30 dk)
# AUTH_OTP_MAX_ATTEMPTS=5               # kod basina yanlis deneme (1-10)
# AUTH_LOGIN_MAX_FAILURES=5             # pencerede izin verilen hata (1-20)
# AUTH_LOGIN_ATTEMPT_WINDOW=PT15M       # brute-force penceresi (1 dk-24 sa)
# AUTH_LOGIN_LOCK_DURATION=PT15M        # kilit suresi (1 dk-24 sa)
# AUTH_MFA_CHALLENGE_TTL=PT5M           # 2FA challenge omru (1-15 dk)
# AUTH_OAUTH_FLOW_TTL=PT10M             # Google/Steam akis omru (1-30 dk)
# AUTH_PASSWORD_RESET_TTL=PT30M         # parola sifirlama baglantisi omru (5 dk-2 sa)

# KOLAY YOL: `node ops/generate-auth-dev-keys.mjs` asagidaki uc Auth anahtarini (JWT, OTP HMAC, TOTP) bos olanlar icin otomatik uretir.
# Yalniz auth-service: RS256 imza anahtari (Base64 PKCS#8 DER, en az 3072 bit). Uretim (Git Bash):
#   openssl genrsa 3072 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
#   (OpenSSL 3.5'te "genpkey ... -outform DER" Java'nin okuyamadigi bir anahtar uretir; bu komutu kullanin)
# Diger servisler yalniz JWKS ile acik anahtari kullanir; ortak ENV blogunda tanimlanmaz.
AUTH_JWT_PRIVATE_KEY=

# Opsiyonel (anahtar rotasyonu): JWKS'te imza anahtarinin yaninda yayinlanan yalniz-dogrulama acik anahtarlari (Base64 X.509 DER,
# en az 3072 bit, virgulle ayrilir). Bos birakilir; uretici betik (ops/generate-auth-dev-keys.mjs) bunu doldurmaz.
# Rotasyon: (1) yeni anahtarin acik halini buraya ekle ve yayinla, (2) tuketicilerin onbellegi dolunca AUTH_JWT_PRIVATE_KEY'i yeniyle degistir,
# eski acik anahtari buraya tasi, (3) en az refresh/JWKS onbellegi suresi sonra eskiyi sil.
# AUTH_JWT_ADDITIONAL_PUBLIC_KEYS=
# Yalniz auth-service: TOTP secret'larinin AES-256-GCM anahtari (Base64, tam 32 bayt):
#   openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=

# Yalniz auth-service: harici giris (Steam anahtar gerektirmez). Google bos ise Google girisi kapali kalir.
# Google Cloud Console > OAuth istemcisi (Web); yetkili yonlendirme URI: <AUTH_PUBLIC_BASE_URL>/api/v1/auth/oauth/google/callback
# AUTH_PUBLIC_BASE_URL: saglayicilarin dondugu, disaridan gorunen Gateway adresi (production icin https zorunlu).
AUTH_PUBLIC_BASE_URL=http://localhost:5080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yalniz auth-service: 6 haneli dogrulama kodlarinin HMAC-SHA256 anahtari.
# Base64, en az 32 bayt; bos veya kisa ise auth-service baslamaz. Ortama ozel uretin:
#   openssl rand -base64 32
# Ortak (tum servislere dagitilan) ENV blogunda tanimlanmaz.
AUTH_OTP_HMAC_KEY=

# ==========================================
# SWAGGER / OPENAPI
# ==========================================

SWAGGER_ENABLED=true

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO

# ==========================================
# SONARQUBE
# ==========================================

SONARQUBE_HOST_PORT=5199
SONARQUBE_INTERNAL_PORT=9000

SONAR_HOST_URL=http://localhost:5199
SONAR_TOKEN=

SONAR_BACKEND_PROJECT_KEY=ltz-backend

# Reserved for the future frontend.
SONAR_FRONTEND_PROJECT_KEY=ltz-frontend

# SONAR DATABASE
SONAR_DB_NAME=ltz_sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=CHANGE_ME_FOR_SONAR

# Auth Service ince ayarlari (hepsi opsiyonel; satirin basindaki # kaldirilarak degistirilir, gosterilen deger varsayilandir).
# Gecersiz/sinir disi deger servisin baslamasini engeller. Guvenlik tabanlari (Argon2 parametreleri, cerez SameSite/Path, JWT algoritmasi) kodda sabittir.
# DEV hizli gelistirme: AUTH_2FA_REQUIRED_ROLES= (bos) ve AUTH_SECURE_COOKIES=false yalniz SPRING_PROFILES_ACTIVE=dev/test iken calisir; baska profilde servis baslamaz.
# AUTH_OTP_RESEND_COOLDOWN=PT60S                    # e-posta kodu yeniden gonderim beklemesi
# AUTH_OTP_DAILY_LIMIT=5                            # gunluk kod gonderim siniri
# AUTH_REFRESH_REUSE_GRACE=PT10S                    # refresh token cok sekme toleransi
# AUTH_SECURE_COOKIES=true                          # Secure/__Host- cerezleri; false yalniz dev/test profilinde
# AUTH_2FA_ISSUER=LTZ                               # authenticator uygulamasinda gorunen ad
# AUTH_2FA_MAX_ATTEMPTS=5                           # 2FA challenge basina yanlis deneme
# AUTH_2FA_RECOVERY_CODE_COUNT=10                   # kurtarma kodu sayisi (5-20)
# AUTH_2FA_CLOCK_SKEW_STEPS=1                       # TOTP saat sapmasi adimi (0-2)
# AUTH_2FA_REQUIRED_ROLES=ADMIN,MODERATOR           # 2FA zorunlu roller; bos = zorunluluk yok, YALNIZ dev/test
# AUTH_STEAM_ASSERTION_MAX_AGE=PT5M                 # Steam yanit yasi siniri
# AUTH_STEAM_REGISTRATION_TTL=PT15M                 # Steam kayit akisi omru
# AUTH_STEAM_PROOF_TTL=PT30M                        # Steam e-posta dogrulama kaniti omru
# AUTH_PASSWORD_RESET_COOLDOWN=PT60S                # sifirlama istegi beklemesi
# AUTH_DELETION_TOKEN_TTL=PT30M                     # silme onay baglantisi omru
# AUTH_DELETION_REQUEST_COOLDOWN=PT60S              # silme istegi beklemesi
# AUTH_DELETION_RECENT_LOGIN_WINDOW=PT10M           # parolasiz hesapta yeniden dogrulama penceresi
# AUTH_DELETION_WORKER_ENABLED=true                 # silme isleyicisi acik/kapali
# AUTH_DELETION_POLL_INTERVAL=PT30S                 # silme isleyicisi tarama araligi
# AUTH_DELETION_BATCH_SIZE=20                       # tek turda islenen silme gorevi
# AUTH_DELETION_LEASE=PT2M                          # gorev kira suresi
# AUTH_DELETION_INITIAL_BACKOFF=PT1M                # ilk yeniden deneme beklemesi
# AUTH_DELETION_MAX_BACKOFF=PT6H                    # en uzun yeniden deneme beklemesi
# AUTH_DELETION_STUCK_ATTEMPTS=10                   # takili sayilan deneme sayisi
# AUTH_CLEANUP_ENABLED=true                         # temizlik isleyicisi acik/kapali
# AUTH_CLEANUP_INTERVAL=PT1H                        # temizlik araligi
# AUTH_CLEANUP_BATCH_SIZE=1000                      # temizlik tur basina kayit
# AUTH_CLEANUP_PENDING_ACCOUNT_TTL=PT24H            # dogrulanmamis hesap omru
# AUTH_CLEANUP_FLOW_GRACE=PT1H                      # OAuth akisi temizlik toleransi
# AUTH_CLEANUP_NONCE_RETENTION=PT1H                 # Steam nonce saklama
# AUTH_CLEANUP_THROTTLE_RETENTION=PT1H              # deneme sayaci saklama
# AUTH_CLEANUP_TOKEN_RETENTION=P2D                  # kod/token saklama
# AUTH_CLEANUP_SESSION_RETENTION=P7D                # oturum saklama
# AUTH_ARGON2_MAX_CONCURRENT=4                      # eszamanli Argon2 hash sayisi
# AUTH_ARGON2_ACQUIRE_TIMEOUT=PT0.5S                # Argon2 slot bekleme suresi
# AUTH_MAX_BODY_SIZE=8KB                            # istek govdesi ust siniri

# Gateway guvenlik katmani (hepsi opsiyonel; gosterilen deger varsayilandir). CORS icin CORS_ALLOWED_ORIGINS kullanilir (tam origin, virgulle ayrilmis, "*" yasak, prod icin https).
# GATEWAY_TRUSTED_PROXIES=                   # istemci IP basligina guvenilecek dogrudan baglanti adresleri (regex); bos = hicbir proxy ye guvenilmez
# GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=120     # Auth uclari icin IP basina dakikalik sinir; 0 = kapali

# ==========================================
# PRODUCTION NOTLARI (Auth + Gateway) - ayrinti: docs/AUTH_SERVICE_ENTEGRASYON_REHBERI.md §13
# ==========================================
# SPRING_PROFILES_ACTIVE=prod  (dev/test/prod disindaki profil adi servisi baslatmaz)
# AUTH_PUBLIC_BASE_URL, FRONTEND_PUBLIC_URL, CORS_ALLOWED_ORIGINS: yalniz https
# AUTH_JWT_PRIVATE_KEY, AUTH_TOTP_ENCRYPTION_KEY, AUTH_OTP_HMAC_KEY: prod icin YENI uretilir, dev anahtarlari kullanilmaz
# AUTH_SECURE_COOKIES=false ve AUTH_2FA_REQUIRED_ROLES=<bos> prod'da servisi baslatmaz
# Mail Service adaptoru hazir olmadan prod profili acilmaz (bilincli)
