# ==========================================
# LOBBYTWOZERO - ENV TEMPLATE
# ==========================================

# APPLICATION
APP_NAME=ltz
APP_ENV=dev
COMPOSE_PROJECT_NAME=ltz-dev
SPRING_PROFILES_ACTIVE=dev
TZ=UTC
# Yalniz development: Mailpit'i baslatir. .env.prod'a EKLENMEZ.
COMPOSE_PROFILES=dev-mail
# Istege bagli Mailpit host portlari (varsayilanlar 1025 / 8025, yalniz 127.0.0.1)
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025

# ==========================================
# FRONTEND
# ==========================================

FRONTEND_HOST_PORT=5001
FRONTEND_INTERNAL_PORT=3000
FRONTEND_PUBLIC_URL=http://localhost:5001
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
CORS_ALLOWED_ORIGINS=http://localhost:5001

# ==========================================
# API GATEWAY
# ==========================================

API_GATEWAY_HOST_PORT=5080
API_GATEWAY_PUBLIC_URL=http://localhost:5080
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080

# ==========================================
# MICROSERVICE HOST PORTS
# ==========================================

AUTH_SERVICE_HOST_PORT=5081
USER_SERVICE_HOST_PORT=5082
MAIL_SERVICE_HOST_PORT=5083

GAME_SERVICE_HOST_PORT=5084
LIBRARY_SERVICE_HOST_PORT=5085
REVIEW_SERVICE_HOST_PORT=5086

SOCIAL_SERVICE_HOST_PORT=5087
MESSAGING_SERVICE_HOST_PORT=5088
LFP_SERVICE_HOST_PORT=5089

COMMUNITY_SERVICE_HOST_PORT=5090
CONTENT_SERVICE_HOST_PORT=5091
EVENT_SERVICE_HOST_PORT=5092

HARDWARE_SERVICE_HOST_PORT=5093
RECOMMENDATION_SERVICE_HOST_PORT=5094
PERFORMANCE_SERVICE_HOST_PORT=5095

ADMIN_SERVICE_HOST_PORT=5096
NOTIFICATION_SERVICE_HOST_PORT=5097

# COMMON CONTAINER PORT
BACKEND_INTERNAL_PORT=8080

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5542

POSTGRES_USER=ltz_dev
POSTGRES_PASSWORD=CHANGE_ME_FOR_DEV
POSTGRES_DB=postgres

DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1

# ==========================================
# DATABASE NAMES
# ==========================================

DB_AUTH_NAME=auth_db
DB_USER_NAME=user_db
DB_MAIL_NAME=mail_db

DB_GAME_NAME=game_db
DB_LIBRARY_NAME=library_db
DB_REVIEW_NAME=review_db

DB_SOCIAL_NAME=social_db
DB_MESSAGING_NAME=messaging_db
DB_LFP_NAME=lfp_db

DB_COMMUNITY_NAME=community_db
DB_CONTENT_NAME=content_db
DB_EVENT_NAME=event_db

DB_HARDWARE_NAME=hardware_db
DB_RECOMMENDATION_NAME=recommendation_db
DB_PERFORMANCE_NAME=performance_db

DB_ADMIN_NAME=admin_db
DB_NOTIFICATION_NAME=notification_db

# ==========================================
# MICROSERVICE INTERNAL URLS
# ==========================================

AUTH_SERVICE_URL=http://auth-service:8080
USER_SERVICE_URL=http://user-service:8080
MAIL_SERVICE_URL=http://mail-service:8080

GAME_SERVICE_URL=http://game-service:8080
LIBRARY_SERVICE_URL=http://library-service:8080
REVIEW_SERVICE_URL=http://review-service:8080

SOCIAL_SERVICE_URL=http://social-service:8080
MESSAGING_SERVICE_URL=http://messaging-service:8080
LFP_SERVICE_URL=http://lfp-service:8080

COMMUNITY_SERVICE_URL=http://community-service:8080
CONTENT_SERVICE_URL=http://content-service:8080
EVENT_SERVICE_URL=http://event-service:8080

HARDWARE_SERVICE_URL=http://hardware-service:8080
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8080
PERFORMANCE_SERVICE_URL=http://performance-service:8080

ADMIN_SERVICE_URL=http://admin-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# ==========================================
# SPRING RESTCLIENT
# ==========================================

REST_CLIENT_CONNECT_TIMEOUT_MS=3000
REST_CLIENT_READ_TIMEOUT_MS=5000

# ==========================================
# SECURITY
# ==========================================

JWT_ISSUER=ltz-auth
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=604800

# Yalniz auth-service: RS256 imza anahtari (Base64 PKCS#8 DER, en az 3072 bit). Uretim (Git Bash):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -outform DER | base64 -w0
# Diger servisler yalniz JWKS ile acik anahtari kullanir; ortak ENV blogunda tanimlanmaz.
AUTH_JWT_PRIVATE_KEY=

# Yalniz auth-service: TOTP secret'larinin AES-256-GCM anahtari (Base64, tam 32 bayt):
#   openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=

# Yalniz auth-service: 6 haneli dogrulama kodlarinin HMAC-SHA256 anahtari.
# Base64, en az 32 bayt; bos veya kisa ise auth-service baslamaz. Ortama ozel uretin:
#   openssl rand -base64 32
# Ortak (tum servislere dagitilan) ENV blogunda tanimlanmaz.
AUTH_OTP_HMAC_KEY=

# ==========================================
# SWAGGER / OPENAPI
# ==========================================

SWAGGER_ENABLED=true

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO

# ==========================================
# SONARQUBE
# ==========================================

SONARQUBE_HOST_PORT=5199
SONARQUBE_INTERNAL_PORT=9000

SONAR_HOST_URL=http://localhost:5199
SONAR_TOKEN=

SONAR_BACKEND_PROJECT_KEY=ltz-backend

# Reserved for the future frontend.
SONAR_FRONTEND_PROJECT_KEY=ltz-frontend

# SONAR DATABASE
SONAR_DB_NAME=ltz_sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=CHANGE_ME_FOR_SONAR
